<p style="color: green"><%= notice %></p>

<%= render @shopping_list %>
<h2>品目</h2>
<% @items.each do |item| %>
  <%= item.name %>
  <%= button_to "削除", [@shopping_list, item], method: :delete %>
<% end %>

<%= form_with model: [@shopping_list, @item] do |form| %>
  <div>
    <%= form.label :name, "品目名" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit "追加" %>
  </div>
<% end %>

<div>
  <%= link_to "Edit this shopping list", edit_shopping_list_path(@shopping_list) %> |
  <%= link_to "Back to shopping lists", shopping_lists_path %>

  <%= button_to "Destroy this shopping list", @shopping_list, method: :delete %>
</div>
