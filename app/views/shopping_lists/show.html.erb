<p style="color: green"><%= notice %></p>

<%= render @shopping_list %>
<h2>まだ買っていないもの</h2>
<% @unpurchased.each do |item| %>
  <%= item.name %>
  <%= button_to "この品目を削除", [@shopping_list, item], method: :delete %>
  <%= button_to "☐", [@shopping_list, item], method: :patch, params: { item: { purchased: true } } %>
<% end %>

<h2>買ったもの</h2>
<% @purchased.each do |item| %>
  <%= item.name %>
  <%= button_to "この品目を削除", [@shopping_list, item], method: :delete %>
  <%= button_to "☑", [@shopping_list, item], method: :patch, params: { item: { purchased: false } } %>
<% end %>

<%= form_with model: [@shopping_list, @item] do |form| %>
  <%= render "shared/error_messages", model: @item %>
  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>

<div>
  <%= link_to "このリストを編集", edit_shopping_list_path(@shopping_list) %> |
  <%= link_to "リスト一覧に戻る", shopping_lists_path %>

  <%= button_to "このリストを削除", @shopping_list, method: :delete %>
</div>
